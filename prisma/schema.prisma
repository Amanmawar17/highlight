generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  fullName         String
  password         String
  email            String    @unique
  profilePic       String?
  phone            String
  expertise        String?
  isUsingCMS       Boolean   @default(false)
  isAdmin          Boolean   @default(false)
  verifyCode       String
  verifyCodeExpiry DateTime
  isVerified       Boolean   @default(false)
  projects         Project[] // User can have many projects
}

model Project {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId        String    @db.ObjectId
  projectPackageId String
  projectName      String
  apiKey           String    @unique
  secret           String    @unique
  project          User      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  article          Article[]
}

model Article {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String
  authorId    String      @db.ObjectId
  author      Project     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  featuredImg String
  images      BlogImage[] @relation("ArticleImages")
}

model BlogImage {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  imagePath String
  article   Article @relation(fields: [articleId], references: [id], name: "ArticleImages", onDelete: Cascade)
  articleId String  @db.ObjectId
}
